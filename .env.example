# Copier en ".env" :  Copy-Item .env.example .env

# Image Floci (emulateur AWS local, gratuit, sans compte ni token).
# Pour la reproductibilite, figer un tag precis plutot que "latest".
FLOCI_IMAGE=floci/floci:latest

LAB_REGION=eu-west-3

# Point d'acces AWS vu depuis le conteneur "lab".
LAB_ENDPOINT=http://floci:4566